# ---- 换行符策略 ----
# 入库统一 LF，避免 Linux/macOS 上出现 "bad interpreter: /bin/sh^M"。
* text=auto

*.sh text eol=lf
*.py text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.geojson text eol=lf
*.html text eol=lf
*.sql text eol=lf
*.txt text eol=lf

# 二进制文件不做换行转换
*.db binary
*.sqlite3 binary
*.png binary
*.jpg binary
*.pdf binary
